<%- include("../templates/cabecera", {subtitulo: 'Crear Usuario'}) %>

<div class="container" style="width: 30%; ">
    <h1 class="display-4">Crear Nuevo Usuario</h1>
    
    <form action="/usuarios" class="my-2" method="POST" >
        <div class="form-group">
            <label for="nombre">Nombre completo</label>
            <input type="text" placeholder="Nombre" class="form-control my-2" name="nombre" required>
        </div>
        
        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" placeholder="Email" class="form-control my-2" name="email" required>
        </div>
        
        <div class="form-group">
            <label for="password">Contraseña</label>
            <input type="password" placeholder="Contraseña" class="form-control my-2" name="password" required>
        </div>
        
        <div class="form-group">
            <label for="instrumento">Instrumento principal</label>
            <input type="text" placeholder="Ej: Guitarra, Batería, Voz..." class="form-control my-2" name="instrumento" required>
        </div>
        
        <div class="form-group">
            <label for="nivel">Nivel de experiencia</label>
            <select name="nivel" class="form-control my-2" required>
                <option value="">Selecciona tu nivel</option>
                <option value="Principiante">Principiante</option>
                <option value="Intermedio">Intermedio</option>
                <option value="Avanzado">Avanzado</option>
                <option value="Profesional">Profesional</option>
            </select>
        </div>
        
        <div class="form-group">
            <label for="generoMusical">Géneros musicales (separados por coma)</label>
            <input type="text" placeholder="Rock, Jazz, Pop..." class="form-control my-2" name="generoMusical">
        </div>
        
        <div class="form-group">
            <label for="ciudad">Ciudad</label>
            <input type="text" placeholder="Ciudad" class="form-control my-2" name="ciudad">
        </div>
        
        <div class="form-group">
            <label for="biografia">Biografía</label>
            <textarea name="biografia" class="form-control my-2" rows="4" placeholder="Cuéntanos sobre ti y tu experiencia musical..."></textarea>
        </div>
        
        <div class="form-group">
            <label for="rol">Tipo de usuario</label>
            <select name="rol" class="form-control my-2">
                <option value="normal">Usuario Normal</option>
                <option value="profesional">Músico Profesional</option>
                <option value="admin">Administrador</option>
            </select>
        </div>
        
        <button type="submit" class="btn btn-dark btn-block">
            Crear Usuario
        </button>
        
        <a href="/usuarios" class="btn btn-secondary btn-block">
            Cancelar
        </a>
    </form>
</div>

<%- include("../templates/footer") %>