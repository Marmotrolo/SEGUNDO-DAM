package fichero;

public class ResultadoComparacion implements Comparable<ResultadoComparacion> {

	private final String nomFichero;
	private final ValorComparacion valorComparacion;
	private final long fechaModificacion;

	public ResultadoComparacion(String nomFichero, ValorComparacion valorComparacion, long fechaModificacion) {
		this.nomFichero = nomFichero;
		this.valorComparacion = valorComparacion;
		this.fechaModificacion = fechaModificacion;
	}

	public String getNomFichero() {
		return nomFichero;
	}

	public ValorComparacion getValorComparacion() {
		return valorComparacion;
	}

	public long getFechaModificacion() {
		return fechaModificacion;
	}

	@Override
	public int compareTo(ResultadoComparacion otro) {
		int comp = this.nomFichero.compareToIgnoreCase(otro.nomFichero);
		if (comp != 0) return comp;
		return Long.compare(this.fechaModificacion, otro.fechaModificacion);
	}

	@Override
	public boolean equals(Object obj) {
		if (this == obj) return true;
		if (!(obj instanceof ResultadoComparacion)) return false;
		ResultadoComparacion otro = (ResultadoComparacion) obj;
		return this.nomFichero.equalsIgnoreCase(otro.nomFichero);
	}

	@Override
	public int hashCode() {
		return nomFichero.toLowerCase().hashCode();
	}

	@Override
	public String toString() {
		return nomFichero + " -> " + valorComparacion;
	}
}
