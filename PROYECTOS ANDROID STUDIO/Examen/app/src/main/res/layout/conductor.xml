<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/conductor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Conductor">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center"
        android:background="#FDD57E">

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hoy te toca:"
            android:layout_gravity="center"
            android:textColor="#D32F2F"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Líneas:"
            android:textColor="#6F0000"
            android:textSize="20sp"
            android:layout_marginBottom="10dp"
            android:textStyle="italic"/>

        <!-- Líneas asignadas -->
        <GridLayout
            android:id="@+id/gridLineas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_gravity="center"
            android:useDefaultMargins="true"
            android:layout_marginBottom="40dp">


            <TextView
                android:layout_width="150dp"
                android:layout_height="80dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:text="Línea 01"
                android:textStyle="bold"
                android:textColor="#D32F2F"/>

            <TextView
                android:layout_width="150dp"
                android:layout_height="80dp"
                android:layout_row="0"
                android:layout_column="1"
                android:background="#FFFFFF"
                android:gravity="center"
                android:text="Línea 03"
                android:textColor="#D32F2F"
                android:textStyle="bold" />
        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bus:"
            android:textColor="#6F0000"
            android:textSize="20sp"
            android:layout_marginBottom="10dp"
            android:textStyle="italic"/>

        <!-- Buses asignados-->
        <GridLayout
            android:id="@+id/gridBuses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:layout_gravity="center"
            android:useDefaultMargins="true"
            android:layout_marginBottom="40dp">

            <TextView
                android:layout_width="150dp"
                android:layout_height="80dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:text="Bus 12"
                android:textStyle="bold"
                android:textColor="#D32F2F"/>
            <TextView
                android:layout_width="150dp"
                android:layout_height="80dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:text="Bus 5"
                android:textStyle="bold"
                android:textColor="#D32F2F"/>
        </GridLayout>

        <Button
            android:id="@+id/botonVolver"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="VOLVER"
            android:layout_gravity="center"
            android:textSize="18sp"
            android:padding="15dp"
            android:backgroundTint="#FF7700"
            app:cornerRadius="25dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
