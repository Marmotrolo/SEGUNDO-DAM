<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rol"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Rol">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center"
        android:background="#FDD57E">

        <!-- Titulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:fontFamily="serif"
            android:text="¿Quién eres?"
            android:textColor="#D32F2F"
            android:textSize="45sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selecciona tu rol"
            android:layout_gravity="center"
            android:textColor="#6F0000"
            android:textStyle="italic"
            android:layout_marginBottom="80dp"
            android:textSize="20sp" />

        <!-- RadioButtons -->
        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50dp">

            <RadioButton
                android:id="@+id/radioConductor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Conductor"
                android:textSize="24sp"
                android:textColor="#D32F2F"
                android:textStyle="bold"
                android:padding="15dp"
                android:layout_marginBottom="25dp" />

            <RadioButton
                android:id="@+id/radioAdministrador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Administrador"
                android:textSize="24sp"
                android:textColor="#D32F2F"
                android:textStyle="bold"
                android:padding="15dp" />

        </RadioGroup>

        <!-- Botones -->
        <Button
            android:id="@+id/botoncontinuar"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="CONTINUAR"
            android:textSize="18sp"
            android:backgroundTint="#FF7700"
            android:padding="15dp"
            app:cornerRadius="25dp" />
        <Button
            android:id="@+id/botonVolver"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="VOLVER"
            android:textSize="18sp"
            android:backgroundTint="#FF7700"
            android:padding="15dp"
            app:cornerRadius="25dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>