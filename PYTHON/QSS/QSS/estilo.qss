QMainWindow {
    background-color: #f5f0e8;
}


/*Estilo check */

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #c4b5a0;
    background-color: #ffffff;
    border-radius: 3px;
}

QCheckBox::indicator:hover {
    border: 2px solid #a89578;
    background-color: #f9f5ee;
}

QCheckBox::indicator:checked {
    background-color: #a89578;
    border: 2px solid #8b7355;
}

QCheckBox::indicator:disabled {
    background-color: #e0e0e0;
    border: 2px solid #cccccc;
}
/* Estilo entrada de texto*/
QLineEdit {
    background-color: #ffffff;
    border: 2px solid #c4b5a0;
    border-radius: 5px;
    padding: 6px;
    font-size: 14px;
    color: #4a4a4a;
}

QLineEdit:focus {
    border: 2px solid #8b7355;
    background-color: #faf8f4;
}
/* Estilo boton */
QPushButton {
    background-color: #c4b5a0;
    color: #4a4a4a;
    border: none;
    border-radius: 5px;
    padding: 8px 16px;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #a89578;
}

QPushButton:pressed {
    background-color: #8b7355;
}

QPushButton:disabled {
    background-color: #e0e0e0;
    color: #a0a0a0;
}
/*Estilo RadioButton*/

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #c4b5a0;
    border-radius: 10px;
    background-color: #ffffff;
}

QRadioButton::indicator:hover {
    border: 2px solid #a89578;
    background-color: #f9f5ee;
}

QRadioButton::indicator:checked {
    background-color: #a89578;
    border: 2px solid #8b7355;
}
/*Estilo combobox */

QComboBox {
    background-color: #ffffff;
    border: 2px solid #c4b5a0;
    border-radius: 5px;
    padding: 6px;
    font-size: 14px;
    color: #4a4a4a;
}

QComboBox:hover {
    border: 2px solid #a89578;
}

QComboBox::drop-down {
    background-color: white;
    border: 2px solid #a89578;
}

QComboBox::down-arrow {
    border: 3px solid #a89578;
}

QComboBox QAbstractItemView {
    background-color: white;
    border: 2px solid #c4b5a0;
    color: #4a4a4a;
}